# Copy to ~/.config/s3ap-client-patterns/stage3.env (outside the repository) and fill in real values.
# The values below are placeholders so that a dry run works without any account.

REGION=ap-northeast-1

# Existing verification FSx for ONTAP. Setup only reads the file system and creates a dedicated
# test volume in this SVM. The SVM must not host an ONTAP object store server.
FS_ID=fs-0123456789abcdef0
SVM_ID=svm-0123456789abcdef0

# Where the EC2 client runs. The security group needs outbound 443 and no inbound rules.
VPC_ID=vpc-0123456789abcdef0
SUBNET_ID=subnet-0123456789abcdef0
SG_ID=sg-0123456789abcdef0

# Access point settings. AP_NETWORK is internet or vpc (a VPC origin binds the access point to VPC_ID).
FS_USER=root
AP_NETWORK=internet

# Test volume size in MiB and client instance type.
VOLUME_SIZE_MB=20480
INSTANCE_TYPE=c6in.xlarge

# Optional. A DNS name or address of the SVM NFS endpoint, for the NFS control mount (route c).
NFS_ENDPOINT=

# Optional run identifiers. Leave empty to generate them.
RUN_ID=
BUCKET_SUFFIX=
